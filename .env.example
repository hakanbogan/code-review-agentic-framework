# OpenAI Configuration (Required)
OPENAI_API_KEY=sk-proj-...your-key-here...

# GitHub Configuration (Required for dataset collection)
GITHUB_TOKEN=ghp_...your-token-here...

# OpenAI Model Settings
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.0
OPENAI_SEED=42

# Anthropic (Optional - alternative to OpenAI)
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...
# ANTHROPIC_MODEL=claude-3-opus-20240229

# Tool Paths (optional - uses system PATH by default)
# RUFF_PATH=ruff
# ESLINT_PATH=eslint
# SEMGREP_PATH=semgrep
# BANDIT_PATH=bandit

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Storage
ARTIFACT_STORAGE=local
ARTIFACT_PATH=./artifacts
REVIEWS_PATH=./reviews

# Evaluation
EVAL_DATASET_PATH=./eval/dataset
EVAL_RESULTS_PATH=./eval/results
SEED_FOR_EXPERIMENTS=42

# Review Configuration
MAX_NITS_PER_REVIEW=5
MAX_PATCH_LINES=10
ENABLE_PARALLEL_AGENTS=true

# Prompts
PROMPT_BASE_PATH=./prompts
DEFAULT_PROMPT_VERSION=v1

# AWS S3 (optional - only if ARTIFACT_STORAGE=s3)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_BUCKET_NAME=...
# S3_REGION=us-east-1
